# Copy to .env locally. Never commit .env.
# Repo is public. Live keys stay on your machine or GitHub Actions secrets.

# --- RPC ---
GROKDESK_RPC=
HELIUS_API_KEY=

# --- Axiom Trade (unofficial community SDK; no first-party public API) ---
# Get tokens after login at https://axiom.trade
# SDK: https://pypi.org/project/axiomtradeapi/
# Docs: https://docs.chipatrade.com/docs/axiomtradeapi/authentication/
AXIOM_ACCESS_TOKEN=
AXIOM_REFRESH_TOKEN=
AXIOM_EMAIL=
AXIOM_PASSWORD=
AXIOM_API_TIMEOUT=30
AXIOM_MAX_RETRIES=3

# --- Photon (Tiny Astro) ---
# No public developer API key. Terminal only:
# https://photon-sol.tinyastro.io/
# Docs: https://photon-sol.tinyastro.io/  (Documentation link on site)
# Optional if you scrape session yourself — leave blank unless you have one.
PHOTON_SESSION=
PHOTON_BASE_URL=https://photon-sol.tinyastro.io

# --- Jito Block Engine ---
# Docs: https://docs.jito.wtf/lowlatencytxnsend/
# Examples: https://github.com/jito-labs/searcher-examples
# UUID rate-limit key (optional, 5 rps works without it):
# header x-jito-auth OR ?uuid=
# Apply higher limits: https://web.miniextensions.com/WV3gZjFwqNqITsMufIEp
JITO_UUID=
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_BUNDLE_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles
JITO_TX_URL=https://mainnet.block-engine.jito.wtf/api/v1/transactions
JITO_RPC_URL=https://mainnet.rpc.jito.wtf
JITO_TIP_ACCOUNT=96gYZGLnJYVFmbjzopPSU6QiEV5fGqZNyN9nmNhvrZU5
JITO_AUTH_KEYPAIR_PATH=

# Regional engines (pick closest):
# https://amsterdam.mainnet.block-engine.jito.wtf
# https://frankfurt.mainnet.block-engine.jito.wtf
# https://london.mainnet.block-engine.jito.wtf
# https://ny.mainnet.block-engine.jito.wtf
# https://tokyo.mainnet.block-engine.jito.wtf
